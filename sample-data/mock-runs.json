{
  "schema_version": "1.0",
  "description": "Twenty mock records for the Proposal Response Orchestration REST endpoint.",
  "base_url": "http://127.0.0.1:8000",
  "prerequisites": [
    "Start the API with python -m orchestration.http_server --port 8000.",
    "Set OPENAI_API_KEY and OPENAI_MODEL for MR-001 through MR-015.",
    "Execute MR-001 before MR-016 using the same tracker.",
    "Poll GET /runs/{run_id} after any 202 response until a terminal status is returned."
  ],
  "records": [
    {
      "id": "MR-001",
      "name": "Successful Cloud Migration intake",
      "method": "POST",
      "path": "/runs",
      "request": {
        "account": "Bank 1",
        "source_url": "https://github.com/CognizantCodex/ProposalResponseOrchestration/blob/develop/sample-data/rfps/mock-01-cloud-migration.md"
      },
      "expected": {
        "http_status": 202,
        "initial_status": "STARTED",
        "terminal_status": "COMPLETED",
        "assertions": [
          "run_id is a UUID",
          "metadata.file_type is md",
          "metadata.duplicate_of is null",
          "classification.requirements contains at least two items",
          "classification.categories includes or maps to Cloud migration",
          "questionnaire is present"
        ]
      }
    },
